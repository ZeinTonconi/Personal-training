typedef long long ll;

const ll MAX_P=1e7;

vector<ll> decompose(ll s){

  vector<ll> d;
  for(ll i=1;i*i<=s;i++){
    if(s%i==0){
      d.push_back(i);
      if(i!=s/i) d.push_back(s/i);
    }
  }
  return d;
}

